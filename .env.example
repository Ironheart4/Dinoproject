# ==================== SUPABASE ====================
# Project URL and Keys from Supabase Dashboard > Settings > API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_KEY=""
SUPABASE_PROFILE_BUCKET="profile-pictures"

# Database connection (Supabase PostgreSQL)
# Get this from: Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres"

# Server
PORT=5000
NODE_ENV=development

# CORS - Allowed origins (comma-separated for production)
# Example: ALLOWED_ORIGINS="https://dinoproject.com,https://www.dinoproject.com"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"
FRONTEND_URL="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_MODE="sandbox"

# Hugging Face (for AI Dino Assistant - free tier)
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=""
